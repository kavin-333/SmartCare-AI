# ============================================================
# SmartCare AI — Server Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control!
# ============================================================

# MongoDB connection string (use MongoDB Atlas URI for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartcareDatabase?retryWrites=true&w=majority

# JWT secret — use a long, random string in production
JWT_SECRET=replace_with_a_long_random_secret_string

# Server port
PORT=8000

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Twilio (for voice/SMS features)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public base URL (used for Twilio webhooks — your ngrok or production URL)
PUBLIC_BASE_URL=https://your-domain.vercel.app
