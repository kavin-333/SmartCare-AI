# ============================================================
# SmartCare AI — Server Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control!
# ============================================================

# MongoDB connection string (use MongoDB Atlas URI for production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartcareDatabase?retryWrites=true&w=majority

# Generate a random value of at least 32 bytes; do not use a shared placeholder.
JWT_SECRET=

# Server port
PORT=8000

# Allowed browser origins (comma-separated). Set production frontend origins
# (e.g., https://smartcare-ai.vercel.app). If omitted, Vercel deployments are allowed by default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://smartcare-ai.vercel.app

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Twilio (for voice/SMS features)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Public base URL Twilio uses to fetch TwiML (must be your LIVE backend Vercel URL).
# Wrong/placeholder hosts (e.g. smartcare-ai-server.vercel.app) cause
# "TwiML application error / URL not reachable" on the call.
PUBLIC_BASE_URL=https://smart-care-ai-a33e.vercel.app
